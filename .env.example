# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
SWAGGER_PATH=docs
# Разрешённые origin для WebSocket (через запятую). Пусто — только тот же origin, что и у API.
CORS_ORIGINS=

# Auth / JWT Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=
CSRF_SECRET=
GUEST_TOKEN_SECRET=
COOKIE_NAME=access_token

# Uploads
UPLOADS_DIR=uploads

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=6500
POSTGRES_USER=vks
POSTGRES_PASSWORD=vks
POSTGRES_DB=vks
DATABASE_URL=postgresql://vks:vks@localhost:6500/vks?schema=public

# Совместное редактирование документов (Hocuspocus). URL должен указывать на COLLABORATION_PORT.
COLLABORATION_PORT=1234
COLLABORATION_URL=ws://127.0.0.1:1234
# COLLABORATION_DEBOUNCE_MS=2000
# COLLABORATION_MAX_DEBOUNCE_MS=10000

# LiveKit. url — для WebRTC-клиентов, apiUrl — для серверного API.
# В production замените на wss:// и https:// своего сервера.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
