generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum RoomType {
  PERMANENT
  TEMPORARY
}

enum RoomAccessType {
  OPEN
  CLOSED
}

enum RoomStatus {
  ACTIVE
  ENDED
}

enum ConferenceStatus {
  ACTIVE
  EMPTY
  ENDED
}

enum ConferenceParticipantRole {
  HOST
  MODERATOR
  PARTICIPANT
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions               AuthSession[]
  passwordResetTokens    PasswordResetToken[]
  rooms                  Room[]
  conferenceParticipants ConferenceParticipant[]
  roomDocuments          RoomDocument[]
}

/// id сессии входит в refresh token, поэтому это UUID, а не последовательный Int.
model AuthSession {
  id               String    @id @db.Uuid
  userId           Int
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  ipAddress        String?
  userAgent        String?

  user               User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conferenceSessions ConferenceParticipantSession[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Комната пользователя. Удаление владельца или комнаты не удаляет историю конференций.
/// Удаление комнаты логическое (deletedAt), slug удалённой комнаты остаётся занятым.
model Room {
  id         String         @id @default(uuid()) @db.Uuid
  ownerId    Int
  name       String
  slug       String         @unique
  type       RoomType
  accessType RoomAccessType
  status     RoomStatus     @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  endedAt    DateTime?
  expiresAt  DateTime?
  deletedAt  DateTime?

  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  conferences Conference[]
  documents   RoomDocument[]

  @@index([ownerId])
}

/// В одной комнате может быть только одна незавершённая конференция (ACTIVE или EMPTY).
model Conference {
  id        String           @id @default(uuid()) @db.Uuid
  roomId    String           @db.Uuid
  status    ConferenceStatus
  startedAt DateTime         @default(now())
  emptyAt   DateTime?
  endedAt   DateTime?

  room         Room                    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  participants ConferenceParticipant[]
  messages     ConferenceMessage[]
  documents    ConferenceDocument[]

  @@unique([roomId], map: "Conference_one_unfinished_per_room", where: raw("(status = ANY (ARRAY['ACTIVE'::\"ConferenceStatus\", 'EMPTY'::\"ConferenceStatus\"]))"))
  @@index([roomId, status])
}

/// Участник конференции: либо userId, либо guestId.
/// CHECK ConferenceParticipant_identity_check запрещает заполнить оба поля или не заполнить ни одного.
/// Повторный вход пользователя или гостя не создаёт вторую запись.
model ConferenceParticipant {
  id           String                    @id @default(uuid()) @db.Uuid
  conferenceId String                    @db.Uuid
  userId       Int?
  guestId      String?                   @db.Uuid
  guestName    String?
  role         ConferenceParticipantRole
  createdAt    DateTime                  @default(now())

  conference Conference                     @relation(fields: [conferenceId], references: [id], onDelete: Restrict)
  user       User?                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions   ConferenceParticipantSession[]
  messages   ConferenceMessage[]

  @@unique([conferenceId, userId], map: "ConferenceParticipant_conferenceId_userId_key", where: { userId: { not: null } })
  @@unique([conferenceId, guestId], map: "ConferenceParticipant_conferenceId_guestId_key", where: { guestId: { not: null } })
  @@index([conferenceId])
  @@index([userId])
}

/// Подключение участника с конкретного устройства. Активных сессий может быть несколько.
/// Подключение пользователя привязано к сессии авторизации и закрывается, когда она отозвана или истекла.
model ConferenceParticipantSession {
  id            String     @id @default(uuid()) @db.Uuid
  participantId String     @db.Uuid
  authSessionId String?    @db.Uuid
  deviceType    DeviceType
  joinedAt      DateTime   @default(now())
  leftAt        DateTime?

  participant ConferenceParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  authSession AuthSession?          @relation(fields: [authSessionId], references: [id], onDelete: SetNull)

  @@index([participantId, leftAt])
  @@index([authSessionId, leftAt])
}

/// Сообщение чата конференции. Сохраняется после завершения конференции.
model ConferenceMessage {
  id            String   @id @default(uuid()) @db.Uuid
  conferenceId  String   @db.Uuid
  participantId String   @db.Uuid
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conference  Conference            @relation(fields: [conferenceId], references: [id], onDelete: Restrict)
  participant ConferenceParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@index([conferenceId, createdAt])
  @@index([participantId])
}

/// Документ комнаты. Одно актуальное состояние Yjs, без копий и снимков по конференциям.
model RoomDocument {
  id          String    @id @default(uuid()) @db.Uuid
  roomId      String    @db.Uuid
  createdById Int?
  title       String
  yjsState    Bytes
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  room        Room                 @relation(fields: [roomId], references: [id], onDelete: Restrict)
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  conferences ConferenceDocument[]

  @@index([roomId, deletedAt])
  @@index([roomId, updatedAt])
  @@index([createdById])
  @@map("room_documents")
}

/// Документ, с которым работали на конкретной конференции. Содержимое не копируется.
model ConferenceDocument {
  id            String    @id @default(uuid()) @db.Uuid
  conferenceId  String    @db.Uuid
  documentId    String    @db.Uuid
  attachedAt    DateTime  @default(now())
  firstEditedAt DateTime?
  lastEditedAt  DateTime?

  conference Conference   @relation(fields: [conferenceId], references: [id], onDelete: Restrict)
  document   RoomDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([conferenceId, documentId])
  @@index([documentId])
  @@index([conferenceId, firstEditedAt])
  @@map("conference_documents")
}
